<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/editText"
        android:layout_width="378dp"
        android:layout_height="87dp"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.437"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.367" />

    <Button
        android:id="@+id/blackText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Чёрный текст"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="389dp"
        android:layout_marginStart="35dp"/>

    <Button
        android:id="@+id/RedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Красный текст"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="389dp"
        android:layout_marginStart="270dp" />

    <Button
        android:id="@+id/Size8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Размер - 8SP"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="477dp"
        android:layout_marginStart="38dp" />

    <Button
        android:id="@+id/Size24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Размер - 24SP"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="475dp"
        android:layout_marginStart="270dp" />

    <Button
        android:id="@+id/WhiteBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Белый фон"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="570dp"
        android:layout_marginStart="38dp"/>

    <Button
        android:id="@+id/YellowBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Жёлтый фон"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="570dp"
        android:layout_marginStart="270dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>